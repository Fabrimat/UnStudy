# Legacy CLI (legacy/riassumi_libro.py) and dev LLM key fallback
NVIDIA_API_KEY=

DATABASE_URL=postgresql://summarize:summarize@localhost:5432/summarize
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=summarize
S3_ACCESS_KEY_ID=summarize
S3_SECRET_ACCESS_KEY=summarize-secret
S3_FORCE_PATH_STYLE=true
# Comma-separated web origins; when set, the API applies a bucket CORS rule at startup
S3_CORS_ORIGIN=
SMTP_URL=smtp://localhost:1025
# Set to send email through Resend's HTTPS API instead of SMTP (needed where outbound SMTP is blocked)
RESEND_API_KEY=
MAIL_FROM=Summarize <no-reply@summarize.local>
WEB_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OCR_LANGS=eng+ita
# Stripe payments (optional): without STRIPE_SECRET_KEY billing is off. Webhook: https://<api>/api/billing/webhook
# events: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PACKS=[{"id":"small","credits":50,"priceId":"price_..."}]
# true only when Stripe Tax is set up (otherwise checkout fails)
STRIPE_AUTOMATIC_TAX=false
# Optional catalogue of LLM providers (api and worker). Unset -> one provider from LLM_BASE_URL/LLM_API_KEY.
# On the API it only seeds the provider table on first boot (no keys); otherwise create providers in Admin > Providers.
# Keys live on the worker as LLM_KEY_<ID> (id upper-cased, '-' -> '_') or via apiKeyEnv below.
# apiKeyEnv is the NAME of the env var holding the key (never put keys in this JSON). tokenParam: max_tokens (default) | max_completion_tokens (OpenAI gpt-5/reasoning).
# maxConcurrency (1..64) caps simultaneous calls to that provider per worker process. baseUrl "fake" = offline test client.
# LLM_PROVIDERS=[{"id":"nvidia","baseUrl":"https://integrate.api.nvidia.com/v1","apiKeyEnv":"NVIDIA_API_KEY"},{"id":"openai","baseUrl":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY","tokenParam":"max_completion_tokens","maxConcurrency":4}]
OPENAI_API_KEY=
# Optional model catalogue, used ONLY as the seed of the database catalogue: the API copies it into the ModelPreset table on first start
# (when the table is empty); afterwards edit models in Admin > Modelli and changing this variable has no effect. First entry that is not adminOnly = default for users; unset -> LLM_MODEL only.
# provider (default: first provider), temperature (0..2, default 0.4, null = do not send), priceIn/priceOut (USD per 1M tokens, Lab cost estimates only),
# adminOnly (true = hidden from users, usable only in the admin Lab).
# LLM_MODELS=[{"id":"fast","label":"Fast","model":"provider/model-id","multiplier":1,"provider":"nvidia","temperature":0.4,"priceIn":0.2,"priceOut":0.6,"adminOnly":false}]
# Worker only: number of summarize jobs processed in parallel (1..16, default 1). Slot 0 only takes user jobs when > 1.
SUMMARIZE_CONCURRENCY=1
# Staging: comma-separated emails; only these accounts can buy. Unset = everyone (live)
# BILLING_ALLOWLIST=me@example.com
# debug|info|warn|error; shared by api and worker
LOG_LEVEL=info
