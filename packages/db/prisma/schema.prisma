generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  email
  google
  apple
}

enum DocumentStatus {
  uploaded
  analyzed
  rejected
}

enum UserRole {
  user
  admin
}

enum JobKind {
  analyze
  summarize
}

enum JobStatus {
  queued
  running
  done
  failed
}

enum LedgerType {
  purchase
  reserve
  charge
  refund
  grant
  revoke
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String            @unique
  name             String?
  createdAt        DateTime          @default(now())
  deletedAt        DateTime?
  /// { language?, lengthPercent?, method?, model? } defaults for new jobs (legacy: fraction)
  preferences      Json              @default("{}")
  /// assigned only by the `role` CLI, never from the UI
  role             UserRole          @default(user)
  accounts         AuthAccount[]
  sessions         Session[]
  documents        Document[]
  jobs             Job[]
  ledger           CreditLedger[]
  methods          SummaryMethod[]
  benchmarks       Benchmark[]
  /// grant/revoke rows this admin wrote from the admin UI
  adminLedger      CreditLedger[]    @relation("LedgerAdmin")
  legalAcceptances LegalAcceptance[]
  legalPublished   LegalDocument[]
}

/// A user's own summary instructions; jobs snapshot them into Job.options, so edits never touch past jobs.
model SummaryMethod {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  instructions String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model AuthAccount {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String

  @@unique([provider, providerAccountId])
}

model MagicLinkToken {
  tokenHash String    @id
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// id = sha256 of the cookie value; the raw token is never stored.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Document {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  s3Key         String
  filename      String
  sizeBytes     Int
  pages         Int?
  words         Int?
  usedOcr       Boolean        @default(false)
  /// [{ title, pageFrom, pageTo, words }]
  chapters      Json?
  status        DocumentStatus @default(uploaded)
  rejectReason  String?
  createdAt     DateTime       @default(now())
  fileDeletedAt DateTime?
  jobs          Job[]
  benchmarks    Benchmark[]

  @@index([userId, createdAt])
}

model Job {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId       String         @db.Uuid
  document         Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind             JobKind
  /// { language, lengthPercent, method, preset?|customInstructions?, chapters?, extras?, modelId, model, phaseModels?: { draft, verify | null }, bibliographicLine? } (legacy: fraction)
  options          Json           @default("{}")
  status           JobStatus      @default(queued)
  attempts         Int            @default(0)
  progress         Int            @default(0)
  phase            String         @default("queued")
  heartbeatAt      DateTime?
  credits          Int            @default(0)
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  /// output of the automatic checks; shown to admins only, never to the job's owner
  warnings         Json           @default("[]")
  /// provider model id actually used (the draft model when phases differ)
  model            String?
  /// wall-clock processing time of the attempt that finished the job
  durationMs       Int?
  resultMdKey      String?
  resultDocxKey    String?
  /// Lab only: the judge's scores (see Evaluation), null when no judge or not yet judged
  evaluation       Json?
  /// user-safe message only
  error            String?
  createdAt        DateTime       @default(now())
  finishedAt       DateTime?
  /// when the API claimed this failed job to email its owner (at-most-once, see JobNotifier)
  failureEmailedAt DateTime?
  /// set on admin lab runs: one job per lane, free (credits 0), never retried
  benchmarkId      String?        @db.Uuid
  benchmark        Benchmark?     @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  ledger           CreditLedger[]
  llmCalls         LlmCall[]

  @@index([status, kind, createdAt])
  @@index([benchmarkId])
  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
}

enum LlmPhase {
  draft
  verify
  judge
}

/// One row per model call, written right after the call (failed attempts included). Internal only.
model LlmCall {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String   @db.Uuid
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt      Int
  chapter      Int
  phase        LlmPhase
  /// provider model id sent to the API
  model        String
  /// LLM_PROVIDERS id and LLM_MODELS catalog id (null on rows written before multi-provider)
  provider     String?
  modelId      String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int
  ok           Boolean
  createdAt    DateTime @default(now())

  @@index([jobId])
  @@index([model, createdAt])
}

/// Admin lab run: the same document and settings summarized once per lane. Admin's own documents only.
model Benchmark {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// { name?, language, lengthPercent, method, chapters?, extras?, lanes: [{ draft, verify }] }
  options    Json
  createdAt  DateTime @default(now())
  jobs       Job[]

  @@index([userId, createdAt])
}

/// Append-only. Balance = SUM(amount). One row per (jobId, type) keeps charge/refund idempotent.
model CreditLedger {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String     @db.Uuid
  user            User       @relation(fields: [userId], references: [id])
  type            LedgerType
  amount          Int
  jobId           String?    @db.Uuid
  job             Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// set on grant/revoke rows written from the admin UI (CLI rows leave it null)
  adminId         String?    @db.Uuid
  admin           User?      @relation("LedgerAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  note            String?
  stripeEventId   String?
  paymentIntentId String?
  createdAt       DateTime   @default(now())

  @@unique([jobId, type])
  @@index([userId])
  @@index([paymentIntentId])
}

/// Processed Stripe webhook events; the PK makes redelivery idempotent.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Editable model catalog. Empty table = the LLM_MODELS env catalog (the API seeds it on first read).
/// Never hard-deleted (jobs and LlmCall reference ids): enabled=false hides it, the worker still resolves it.
model ModelPreset {
  id          String   @id
  label       String
  /// an LLM_PROVIDERS id (keys stay in env)
  provider    String
  /// provider model id
  model       String
  multiplier  Float
  /// null = do not send temperature
  temperature Float?
  /// USD per 1M tokens, Lab/stats cost estimates only
  priceIn     Float?
  priceOut    Float?
  adminOnly   Boolean  @default(false)
  enabled     Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// LLM endpoints (keys stay in env). Key = env LLM_KEY_<ID> (upper, '-'->'_'), else the apiKeyEnv of the same id in env LLM_PROVIDERS.
/// No FK from ModelPreset.provider: the lazy seed runs after migration; the app checks under CATALOG_LOCK.
model LlmProvider {
  id             String   @id
  /// http(s)://... or "fake"
  baseUrl        String
  /// max_tokens | max_completion_tokens
  tokenParam     String   @default("max_tokens")
  /// 1..64
  maxConcurrency Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Written by the worker: whether it resolved a key for this provider id. Presence only, never the key.
/// No FK: env-only providers are reported too. source = LLM_KEY (env LLM_KEY_<ID>) | LLM_PROVIDERS (apiKeyEnv of the env entry) | none.
model ProviderKeyStatus {
  id        String   @id
  hasKey    Boolean
  source    String
  checkedAt DateTime
}

enum LegalKind {
  terms
  privacy
}

/// Insert-only: publishing = a new row with version = max+1. The current text of a kind is its highest version.
model LegalDocument {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        LegalKind
  version     Int
  /// markdown
  body        String
  createdAt   DateTime          @default(now())
  createdById String            @db.Uuid
  createdBy   User              @relation(fields: [createdById], references: [id])
  acceptances LegalAcceptance[]

  @@unique([kind, version])
}

/// Evidence that a user accepted one exact published version.
model LegalAcceptance {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id])
  documentId String        @db.Uuid
  document   LegalDocument @relation(fields: [documentId], references: [id])
  acceptedAt DateTime      @default(now())

  @@unique([userId, documentId])
}

/// Admin override of a code-side default email (registry: apps/api/src/auth/email-templates.ts). No row = default.
model EmailTemplate {
  key         String   @id
  subject     String
  body        String
  updatedAt   DateTime @updatedAt
  updatedById String
}

/// Saved Lab setup (lanes + judge), applied from Admin > Lab. Model ids are not FKs: the catalogue may change.
model LabPreset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  /// judge model id
  judge     String?
  /// [{ draft, verify | null, harness? }], same shape as the benchmark lanes
  lanes     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
